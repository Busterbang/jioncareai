{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/health"
    },
    {
      "source": "/healthz",
      "destination": "/healthz"
    },
    {
      "source": "/ready",
      "destination": "/ready"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
