# Copy to .env and provide project-local values; never commit secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# Optional private 32+ character device HMAC key; the app safely derives one from this
# server-only service-role key when the override is missing or overlaps a public key.
DEVICE_AUTH_SECRET=
DEMO_MODE=false
