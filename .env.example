# Browser-safe Supabase configuration (publishable key only; RLS still required)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy/current alias accepted by backend setup if preferred
PUBLIC_SUPABASE_ANON_KEY=

# Server-only FastAPI configuration: never prefix with PUBLIC_ or expose in JavaScript.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional distinct 32+ character HMAC key. When omitted, weak, or overlapping a public
# Supabase key, the backend derives a domain-separated key from SUPABASE_SERVICE_ROLE_KEY.
DEVICE_AUTH_SECRET=

# Optional direct PostgreSQL connection (not required by the REST-based backend)
DATABASE_URL=

# Browser requests use same-origin paths in the hosted app and Astro proxy in local dev.
API_BASE_URL=/api/v1
